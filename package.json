{
  "name": "ai-slop-labels",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.0.0-rc.8",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @ai-slop-labels/api --filter @ai-slop-labels/extension dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  }
}
